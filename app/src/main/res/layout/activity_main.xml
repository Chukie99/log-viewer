<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F5EFE6" android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🔍 Log Viewer — Universal" android:textSize="18sp" android:textStyle="bold" android:textColor="#0F2440"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Filter package (kosongkan = semua FATAL):" android:textSize="11sp" android:textColor="#5A758F" android:layout_marginTop="10dp"/>
    <EditText android:id="@+id/filterInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="com.chukie99.posumkm" android:text="com.chukie99.posumkm" android:textSize="13sp"
        android:background="@android:drawable/edit_text" android:padding="10dp" android:layout_marginTop="4dp"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="1. Bersihkan" android:textSize="11sp"/>
        <Button android:id="@+id/btnCatch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="2. Tangkap Crash" android:textSize="11sp" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
        <Button android:id="@+id/btnOpen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="3. Buka App" android:textSize="11sp"/>
        <Button android:id="@+id/btnShare" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Copy/Share" android:textSize="11sp" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Langkah: Bersihkan → Buka Kasir Kita sampai FC → kembali → Tangkap Crash" android:textSize="10sp" android:textColor="#5A758F" android:layout_marginTop="8dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:background="#FFFFFF">
        <TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="10sp" android:textColor="#1A1A1A" android:padding="10dp"
            android:text="Log akan muncul di sini...\n\nJika kosong: colok HP ke PC 1x jalankan:\nadb shell pm grant com.chukie99.logviewer android.permission.READ_LOGS"/>
    </ScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tanpa PC: install Shizuku + kasih izin dulu kalau log kosong (Android 13+)." android:textSize="9sp" android:textColor="#8A9BB0" android:layout_marginTop="6dp"/>
</LinearLayout>
